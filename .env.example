# AnalyticCastle frontend — public environment

# Required: AnalyticCastle FastAPI base URL (no trailing slash).
# Prefer NEXT_PUBLIC_API_BASE_URL. NEXT_PUBLIC_API_URL remains supported.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Compatibility alias (used if NEXT_PUBLIC_API_BASE_URL is unset):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Local checklist:
# 1. Start AnalyticCastle backend from c:\projects\analytic_castle_backend
#    (uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload).
# 2. Open http://127.0.0.1:8000/docs — title must be "AnalyticCastle".
#    If another API owns :8000, use a free port and set this env to match.
# 3. Confirm GET /health/live returns healthy.
# 4. Confirm OpenAPI lists /api/v1/auth/login, /api/v1/ai/chat, and conversations.
# 5. Run the frontend on http://localhost:3000 (allowed by backend CORS defaults).
# 6. Backend .env must set:
#      FRONTEND_URL=http://localhost:3000
#      CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#      CORS_ALLOW_CREDENTIALS=true
